# Prerequisites: prepared Fabric network/channel/evidence chaincode plus MySQL, Garage and RabbitMQ.
# Start the real anchor consumer: python3 deploy/scripts/run-backend.py --demo --ledger
# Complete t009.http, t010.http and t011.http; copy the uploadId used in t011.http below.
# Real passwords and tokens belong in an ignored REST Client environment.
@baseUrl = http://127.0.0.1:8080
@uploadId = REPLACE_WITH_COMPLETED_UPLOAD_UUID
@operatorUserPassword = REPLACE_WITH_OPERATOR_USER_PASSWORD
@ownerAdminPassword = REPLACE_WITH_OWNER_ADMIN_PASSWORD
@operatorOutsiderPassword = REPLACE_WITH_OPERATOR_OUTSIDER_PASSWORD

### Log in as the actual uploader and task member
# @name uploaderLogin
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{"username":"operator-user","password":"{{operatorUserPassword}}"}

### Obtain versionId after processingStatus=COMPLETED
# @name upload
GET {{baseUrl}}/api/v1/upload-sessions/{{uploadId}}
Authorization: Bearer {{uploaderLogin.response.body.$.data.accessToken}}

### Read immutable metadata and persisted anchor status; no object keys or binary checkpoints
# @name version
GET {{baseUrl}}/api/v1/evidence-versions/{{upload.response.body.$.data.versionId}}
Authorization: Bearer {{uploaderLogin.response.body.$.data.accessToken}}

### Poll until status=CONFIRMED; confirmedTxId is the first ledger registration transaction
# PENDING awaits processing, SUBMITTED awaits confirmation, UNKNOWN is a persisted uncertain result.
# A timeout never means the Fabric transaction failed. Recovery uses the saved original transaction.
GET {{baseUrl}}/api/v1/evidence-versions/{{upload.response.body.$.data.versionId}}/anchor
Authorization: Bearer {{uploaderLogin.response.body.$.data.accessToken}}

### The owner administrator created the task in t009.http and is an explicit task member
# @name ownerLogin
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{"username":"owner-admin","password":"{{ownerAdminPassword}}"}

### Both institutions' task members can read the same persisted anchor view
GET {{baseUrl}}/api/v1/evidence-versions/{{upload.response.body.$.data.versionId}}/anchor
Authorization: Bearer {{ownerLogin.response.body.$.data.accessToken}}

### A user with OPERATOR_USER but no task membership cannot read the version
# @name outsiderLogin
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{"username":"operator-outsider","password":"{{operatorOutsiderPassword}}"}

### 403: role alone does not grant this task's evidence
GET {{baseUrl}}/api/v1/evidence-versions/{{upload.response.body.$.data.versionId}}
Authorization: Bearer {{outsiderLogin.response.body.$.data.accessToken}}

### 401: version and anchor endpoints both require a valid current account
GET {{baseUrl}}/api/v1/evidence-versions/{{upload.response.body.$.data.versionId}}/anchor
