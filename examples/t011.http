# Prerequisites: run t009.http and t010.http to create a running task and upload all parts.
# Start MySQL, Garage and RabbitMQ, then: python3 deploy/scripts/run-backend.py --demo
# Copy uploadId from t010.http. Real credentials belong in an ignored REST Client environment.
@baseUrl = http://127.0.0.1:8080
@uploadId = REPLACE_WITH_FULLY_UPLOADED_SESSION_UUID
@operatorUserPassword = REPLACE_WITH_OPERATOR_USER_PASSWORD
@operatorAdminPassword = REPLACE_WITH_OPERATOR_ADMIN_PASSWORD

### Log in as the actual owner of the upload session
# @name uploaderLogin
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{"username":"operator-user","password":"{{operatorUserPassword}}"}

### Check all uploadedParts and uploadedSize before completion
GET {{baseUrl}}/api/v1/upload-sessions/{{uploadId}}
Authorization: Bearer {{uploaderLogin.response.body.$.data.accessToken}}

### Freeze the upload and enqueue finalization atomically; no body, HTTP 202
# @name completion
POST {{baseUrl}}/api/v1/upload-sessions/{{uploadId}}/complete
Authorization: Bearer {{uploaderLogin.response.body.$.data.accessToken}}
X-Trace-Id: t011-complete

### Poll this request until processingStatus=COMPLETED and versionId is present
# VERIFYING means queued or retrying. FAILED means file verification failed; create a new session.
# COMPLETED is a fixed file version. Fabric confirmation is implemented in T012.
GET {{baseUrl}}/api/v1/upload-sessions/{{uploadId}}
Authorization: Bearer {{uploaderLogin.response.body.$.data.accessToken}}

### Repeat completion after timeout or success: HTTP 202, original progress/versionId, no extra version
POST {{baseUrl}}/api/v1/upload-sessions/{{uploadId}}/complete
Authorization: Bearer {{uploaderLogin.response.body.$.data.accessToken}}
X-Trace-Id: t011-complete-repeat

### Once frozen, a part write is rejected with 409 UPLOAD_NOT_WRITABLE
PUT {{baseUrl}}/api/v1/upload-sessions/{{uploadId}}/parts/1
Authorization: Bearer {{uploaderLogin.response.body.$.data.accessToken}}
Content-Type: application/octet-stream
X-Trace-Id: t011-frozen-part

< ./files/inspection-sample.png

### Another task member still cannot complete this uploader's session
# @name adminLogin
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{"username":"operator-admin","password":"{{operatorAdminPassword}}"}

### 403: OPERATOR_TASK_ADMIN alone has no upload ownership or OPERATOR_USER role
POST {{baseUrl}}/api/v1/upload-sessions/{{uploadId}}/complete
Authorization: Bearer {{adminLogin.response.body.$.data.accessToken}}
