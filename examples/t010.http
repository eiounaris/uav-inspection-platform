# Prerequisite: run t009.http to create and start a real task, then set taskId below.
# Start backend: python3 deploy/scripts/run-backend.py --demo (JDK 21, MySQL and Garage running).
# Keep real passwords/tokens in an ignored REST Client environment.
@baseUrl = http://127.0.0.1:8080
@taskId = REPLACE_WITH_STARTED_TASK_UUID
@operatorAdminPassword = REPLACE_WITH_OPERATOR_ADMIN_PASSWORD
@operatorUserPassword = REPLACE_WITH_OPERATOR_USER_PASSWORD
@operatorAdminId = 10000000-0000-4000-8000-000000000004
@operatorUserId = 10000000-0000-4000-8000-000000000005
# Keep this UUID for retries of this logical upload; use a new one for another file/task.
@clientRequestId = 30000000-0000-4000-8000-000000000010

### Log in the task administrator and the actual uploader
# @name adminLogin
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{"username":"operator-admin","password":"{{operatorAdminPassword}}"}

### The uploader must have OPERATOR_USER; organization administration alone is insufficient
# @name userLogin
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{"username":"operator-user","password":"{{operatorUserPassword}}"}

### Get the current task version and the single requirement/execution from t009.http
# @name task
GET {{baseUrl}}/api/v1/tasks/{{taskId}}
Authorization: Bearer {{adminLogin.response.body.$.data.accessToken}}

### Add the uploader, retaining the operator administrator and the owner's members
PUT {{baseUrl}}/api/v1/tasks/{{taskId}}/members
Authorization: Bearer {{adminLogin.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "userIds": ["{{operatorAdminId}}", "{{operatorUserId}}"],
  "expectedLockVersion": {{task.response.body.$.data.lockVersion}}
}

### Create a session for the bundled 79-byte PNG; repeat unchanged to reuse it
# @name upload
POST {{baseUrl}}/api/v1/upload-sessions
Authorization: Bearer {{userLogin.response.body.$.data.accessToken}}
Content-Type: application/json
X-Trace-Id: t010-create

{
  "clientRequestId": "{{clientRequestId}}",
  "requirementId": "{{task.response.body.$.data.requirements[0].id}}",
  "executionId": "{{task.response.body.$.data.subtasks[0].currentExecutionId}}",
  "filename": "inspection-sample.png",
  "contentType": "image/png",
  "size": 79
}

### Upload raw bytes, not multipart/form-data. Part numbers start at 1.
PUT {{baseUrl}}/api/v1/upload-sessions/{{upload.response.body.$.data.uploadId}}/parts/1
Authorization: Bearer {{userLogin.response.body.$.data.accessToken}}
Content-Type: application/octet-stream
X-Trace-Id: t010-part

< ./files/inspection-sample.png

### Repeating the same bytes returns the existing part without creating another record
PUT {{baseUrl}}/api/v1/upload-sessions/{{upload.response.body.$.data.uploadId}}/parts/1
Authorization: Bearer {{userLogin.response.body.$.data.accessToken}}
Content-Type: application/octet-stream
X-Trace-Id: t010-part-repeat

< ./files/inspection-sample.png

### Progress comes from MySQL. T010 remains UPLOADING with versionId=null.
GET {{baseUrl}}/api/v1/upload-sessions/{{upload.response.body.$.data.uploadId}}
Authorization: Bearer {{userLogin.response.body.$.data.accessToken}}

### Another task member does not own this session: 403
GET {{baseUrl}}/api/v1/upload-sessions/{{upload.response.body.$.data.uploadId}}
Authorization: Bearer {{adminLogin.response.body.$.data.accessToken}}
