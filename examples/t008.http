# Start with: python3 deploy/scripts/run-backend.py --demo
# Read the selected account's password locally from .local/demo-credentials.json.
# Keep real credentials/token overrides in an ignored REST Client environment file.
@baseUrl = http://127.0.0.1:8080
@username = owner-admin
@password = REPLACE_WITH_LOCAL_PASSWORD
@targetUserId = REPLACE_WITH_SAME_ORG_USER_UUID
@expectedLockVersion = 0

### Login; only username/password are accepted
# @name login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
X-Trace-Id: t008-login

{
  "username": "{{username}}",
  "password": "{{password}}"
}

### Current identity; roles and organization come from the database
GET {{baseUrl}}/api/v1/users/me
Authorization: Bearer {{login.response.body.$.data.accessToken}}
X-Trace-Id: t008-me

### OrgA administrator changes a same-organization account's roles
# Replace targetUserId and use that account's current lockVersion.
# Success increments both target versions and invalidates its older tokens.
# An OrgB target must instead use OrgB roles and an OrgB administrator.
PUT {{baseUrl}}/api/v1/users/{{targetUserId}}/roles
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json
X-Trace-Id: t008-roles

{
  "roles": ["OWNER_REVIEWER"],
  "expectedLockVersion": {{expectedLockVersion}}
}

### Logout; no body. All tokens issued at this account version become invalid
POST {{baseUrl}}/api/v1/auth/logout
Authorization: Bearer {{login.response.body.$.data.accessToken}}
X-Trace-Id: t008-logout

### Reusing the token after logout must return 401
GET {{baseUrl}}/api/v1/users/me
Authorization: Bearer {{login.response.body.$.data.accessToken}}
X-Trace-Id: t008-after-logout

### A client-supplied organization is rejected with 400
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
X-Trace-Id: t008-reject-org

{
  "username": "{{username}}",
  "password": "{{password}}",
  "orgId": "00000000-0000-4000-8000-000000000002"
}
