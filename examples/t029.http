# T029：四设备、三子任务、旧新版本及精确共享的手动串联模板。
# 自动生成并保留演示成果：python3 deploy/scripts/run-demo.py
# 复查已生成成果：python3 deploy/scripts/run-demo.py --recheck .local/full-demo/<runId>
# 自动入口自行启动打包后端，先停止普通项目后端与消费者。手动请求则先启动：
#   python3 deploy/scripts/run-backend.py --ledger
# 请求目录、身份/锁号/变量来源见 examples/README.md。不要直接“发送整个文件”。
# JWT有效期30分钟；手动演示超时后重新登录并更新JWT，不重置上传/共享请求身份。
# 所有 REPLACE 值在本机忽略提交的私有 HTTP 环境中填写，不能把真实凭据写回本文件。
# 密码来自原 .local/demo-credentials.json；不重置账号、角色或原 M2 业务。

@baseUrl = http://127.0.0.1:8080/api/v1
@runLabel = REPLACE_NEW_SHORT_ALPHANUMERIC_LABEL
@ownerPassword = REPLACE_PRIVATE_OWNER_ADMIN_PASSWORD
@adminPassword = REPLACE_PRIVATE_OPERATOR_ADMIN_PASSWORD
@uploaderPassword = REPLACE_PRIVATE_OPERATOR_USER_PASSWORD
@reviewerPassword = REPLACE_PRIVATE_OWNER_REVIEWER_PASSWORD
@approverPassword = REPLACE_PRIVATE_OWNER_APPROVER_PASSWORD
@outsiderPassword = REPLACE_PRIVATE_OPERATOR_OUTSIDER_PASSWORD
@ownerToken = REPLACE_FROM_OWNER_LOGIN_DATA_ACCESS_TOKEN
@adminToken = REPLACE_FROM_ADMIN_LOGIN_DATA_ACCESS_TOKEN
@uploaderToken = REPLACE_FROM_UPLOADER_LOGIN_DATA_ACCESS_TOKEN
@reviewerToken = REPLACE_FROM_REVIEWER_LOGIN_DATA_ACCESS_TOKEN
@approverToken = REPLACE_FROM_APPROVER_LOGIN_DATA_ACCESS_TOKEN
@outsiderToken = REPLACE_FROM_OUTSIDER_LOGIN_DATA_ACCESS_TOKEN
@operatorOrgId = 00000000-0000-4000-8000-000000000002
@operatorAdminId = 10000000-0000-4000-8000-000000000004
@uploaderId = 10000000-0000-4000-8000-000000000005
@reviewerId = 10000000-0000-4000-8000-000000000002
@approverId = 10000000-0000-4000-8000-000000000003

# 创建后按名称从 task.requirements/subtasks 复制编号，不假定响应数组顺序。
@taskId = REPLACE_NEW_TASK_UUID
@taskLockVersion = REPLACE_CURRENT_TASK_LOCK_VERSION_INTEGER
@northRequirementId = REPLACE_NORTH_REQUIREMENT_UUID
@centralRequirementId = REPLACE_CENTRAL_REQUIREMENT_UUID
@southRequirementId = REPLACE_SOUTH_REQUIREMENT_UUID
@northSubtaskId = REPLACE_NORTH_SUBTASK_UUID
@centralSubtaskId = REPLACE_CENTRAL_SUBTASK_UUID
@southSubtaskId = REPLACE_SOUTH_SUBTASK_UUID
@northSubtaskLockVersion = REPLACE_CURRENT_NORTH_SUBTASK_LOCK_VERSION_INTEGER
@centralSubtaskLockVersion = REPLACE_CURRENT_CENTRAL_SUBTASK_LOCK_VERSION_INTEGER
@southSubtaskLockVersion = REPLACE_CURRENT_SOUTH_SUBTASK_LOCK_VERSION_INTEGER
@northOldExecutionId = REPLACE_INITIAL_NORTH_EXECUTION_UUID
@northExecutionId = REPLACE_CURRENT_NORTH_EXECUTION_UUID_AFTER_SWAP
@centralExecutionId = REPLACE_CENTRAL_EXECUTION_UUID
@southExecutionId = REPLACE_SOUTH_EXECUTION_UUID

# 注册响应 data.device.id 和只返回一次的 data.deviceToken；令牌只留本地私有环境。
@deviceAId = REPLACE_NEW_DEVICE_A_UUID
@deviceAToken = REPLACE_PRIVATE_DEVICE_A_TOKEN
@deviceBId = REPLACE_NEW_DEVICE_B_UUID
@deviceBToken = REPLACE_PRIVATE_DEVICE_B_TOKEN
@deviceCId = REPLACE_NEW_DEVICE_C_UUID
@deviceCToken = REPLACE_PRIVATE_DEVICE_C_TOKEN
@deviceDId = REPLACE_NEW_SPARE_DEVICE_D_UUID
@deviceDToken = REPLACE_PRIVATE_DEVICE_D_TOKEN
@bootA = REPLACE_NEW_BOOT_A_UUID
@bootB = REPLACE_NEW_BOOT_B_UUID
@bootC = REPLACE_NEW_BOOT_C_UUID
@bootD = REPLACE_NEW_BOOT_D_UUID
@heartbeatAEventId = REPLACE_NEW_HEARTBEAT_A_EVENT_UUID
@progressAEventId = REPLACE_NEW_PROGRESS_A_EVENT_UUID
@progressBEventId = REPLACE_NEW_PROGRESS_B_EVENT_UUID
@progressCEventId = REPLACE_NEW_PROGRESS_C_EVENT_UUID
@lateAEventId = REPLACE_NEW_LATE_A_EVENT_UUID
@progressDEventId = REPLACE_NEW_PROGRESS_D_EVENT_UUID

# 同一次上传重试保持原请求 UUID；每个新版本/资料使用各自新 UUID。
@oldUploadRequestId = REPLACE_NEW_OLD_UPLOAD_REQUEST_UUID
@newUploadRequestId = REPLACE_NEW_REVISED_UPLOAD_REQUEST_UUID
@centralUploadRequestId = REPLACE_NEW_CENTRAL_UPLOAD_REQUEST_UUID
@southUploadRequestId = REPLACE_NEW_SOUTH_UPLOAD_REQUEST_UUID
@oldUploadId = REPLACE_OLD_UPLOAD_SESSION_UUID
@newUploadId = REPLACE_REVISED_UPLOAD_SESSION_UUID
@centralUploadId = REPLACE_CENTRAL_UPLOAD_SESSION_UUID
@southUploadId = REPLACE_SOUTH_UPLOAD_SESSION_UUID
@oldVersionId = REPLACE_OLD_NORTH_FIXED_VERSION_UUID
@newVersionId = REPLACE_REVISED_NORTH_FIXED_VERSION_UUID
@centralVersionId = REPLACE_CENTRAL_FIXED_VERSION_UUID
@southVersionId = REPLACE_SOUTH_FIXED_VERSION_UUID
@revisedSize = 74
@oldGrantRequestId = REPLACE_NEW_V1_GRANT_REQUEST_UUID
@newGrantRequestId = REPLACE_NEW_V2_GRANT_REQUEST_UUID
@oldGrantId = REPLACE_V1_GRANT_UUID
@newGrantId = REPLACE_V2_GRANT_UUID
@oldGrantLockVersion = REPLACE_CURRENT_V1_GRANT_LOCK_VERSION_INTEGER
@newGrantLockVersion = REPLACE_CURRENT_V2_GRANT_LOCK_VERSION_INTEGER
@requestedValidUntil = REPLACE_FUTURE_UTC_ISO_INSTANT_WITHIN_24_HOURS
@validUntil = REPLACE_FUTURE_UTC_ISO_INSTANT_WITHIN_12_HOURS

### 1. 委托方任务管理员登录；复制 data.accessToken 到私有 ownerToken
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"username":"owner-admin","password":"{{ownerPassword}}"}

### 运营方任务管理员登录
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"username":"operator-admin","password":"{{adminPassword}}"}

### 任务资料上传员登录
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"username":"operator-user","password":"{{uploaderPassword}}"}

### 委托方资料复核员登录
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"username":"owner-reviewer","password":"{{reviewerPassword}}"}

### 委托方共享审批人登录
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"username":"owner-approver","password":"{{approverPassword}}"}

### 任务外用户登录：不加入此演示任务，只通过指定版本授权取得访问
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"username":"operator-outsider","password":"{{outsiderPassword}}"}

### 可对每个账号分别读取 me，确认真实用户编号、机构及角色，不以用户名猜权限
GET {{baseUrl}}/users/me
Authorization: Bearer {{ownerToken}}

### 2. 创建全新三资料项任务；复制 data.id 和按名称匹配的 requirement.id
POST {{baseUrl}}/tasks
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

< ./data/t029-task.json

### taskSnapshot：每次任务修改前重新发送，填入本次 taskLockVersion
# initial allocation / 换机也可能更新聚合任务锁；不要连续复用旧锁号。
GET {{baseUrl}}/tasks/{{taskId}}
Authorization: Bearer {{ownerToken}}

### 指派运营机构及管理员；data.status=ASSIGNED
POST {{baseUrl}}/tasks/{{taskId}}/assign
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{"operatorOrgId":"{{operatorOrgId}}","operatorAdminId":"{{operatorAdminId}}","expectedLockVersion":{{taskLockVersion}}}

### 刷新 taskSnapshot 后，委托方加入复核/审批人；创建人与对方成员保留
PUT {{baseUrl}}/tasks/{{taskId}}/members
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{"userIds":["{{reviewerId}}","{{approverId}}"],"expectedLockVersion":{{taskLockVersion}}}

### 再刷新 taskSnapshot 后，运营方加入资料上传员；只替换自己机构的成员
PUT {{baseUrl}}/tasks/{{taskId}}/members
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"userIds":["{{operatorAdminId}}","{{uploaderId}}"],"expectedLockVersion":{{taskLockVersion}}}

### 3. 新注册设备 A：初始北区；每次整轮演示使用新的 runLabel
POST {{baseUrl}}/drones
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"code":"T029-{{runLabel}}-A"}

### 新注册设备 B：初始中区
POST {{baseUrl}}/drones
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"code":"T029-{{runLabel}}-B"}

### 新注册设备 C：初始南区
POST {{baseUrl}}/drones
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"code":"T029-{{runLabel}}-C"}

### 新注册设备 D：备用，稍后替换北区 A；四个响应都要私密保存一次性令牌
POST {{baseUrl}}/drones
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"code":"T029-{{runLabel}}-D"}

### 设备列表不含令牌；新设备未上报时 online=false 是实际状态
GET {{baseUrl}}/drones?page=1&pageSize=20
Authorization: Bearer {{adminToken}}

### 4. 每条 POST 前刷新 taskSnapshot；按响应名称填回各 subtaskId 和子任务锁号
POST {{baseUrl}}/tasks/{{taskId}}/subtasks
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"name":"北区线路执行","requirementIds":["{{northRequirementId}}"],"expectedLockVersion":{{taskLockVersion}}}

### 创建中区子任务，使用最新 taskLockVersion
POST {{baseUrl}}/tasks/{{taskId}}/subtasks
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"name":"中区线路执行","requirementIds":["{{centralRequirementId}}"],"expectedLockVersion":{{taskLockVersion}}}

### 创建南区子任务，使用最新 taskLockVersion
POST {{baseUrl}}/tasks/{{taskId}}/subtasks
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"name":"南区线路执行","requirementIds":["{{southRequirementId}}"],"expectedLockVersion":{{taskLockVersion}}}

### 给北区分配 A：锁号属于北区子任务，复制其 READY execution.id 为 northOldExecutionId
POST {{baseUrl}}/subtasks/{{northSubtaskId}}/executions
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"droneId":"{{deviceAId}}","expectedLockVersion":{{northSubtaskLockVersion}}}

### 给中区分配 B，复制 READY execution.id 为 centralExecutionId
POST {{baseUrl}}/subtasks/{{centralSubtaskId}}/executions
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"droneId":"{{deviceBId}}","expectedLockVersion":{{centralSubtaskLockVersion}}}

### 给南区分配 C，复制 READY execution.id 为 southExecutionId
POST {{baseUrl}}/subtasks/{{southSubtaskId}}/executions
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"droneId":"{{deviceCId}}","expectedLockVersion":{{southSubtaskLockVersion}}}

### 三次分配后先刷新 taskSnapshot，再启动：三 READY 批次原编号保持并变 RUNNING
POST {{baseUrl}}/tasks/{{taskId}}/start
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"expectedLockVersion":{{taskLockVersion}}}

### 5. 设备 A 原批次心跳，用户 Bearer 不能代替设备身份
POST {{baseUrl}}/device/reports
X-Device-Id: {{deviceAId}}
X-Device-Token: {{deviceAToken}}
Content-Type: application/json

{"bootId":"{{bootA}}","seq":0,"eventId":"{{heartbeatAEventId}}","executionId":"{{northOldExecutionId}}","type":"HEARTBEAT"}

### 将上一心跳原样重发一次：duplicate=true，原 receivedAt 不变，不重复累计事件
POST {{baseUrl}}/device/reports
X-Device-Id: {{deviceAId}}
X-Device-Token: {{deviceAToken}}
Content-Type: application/json

{"bootId":"{{bootA}}","seq":0,"eventId":"{{heartbeatAEventId}}","executionId":"{{northOldExecutionId}}","type":"HEARTBEAT"}

### 设备 A 当前进度 35
POST {{baseUrl}}/device/reports
X-Device-Id: {{deviceAId}}
X-Device-Token: {{deviceAToken}}
Content-Type: application/json

{"bootId":"{{bootA}}","seq":1,"eventId":"{{progressAEventId}}","executionId":"{{northOldExecutionId}}","type":"PROGRESS","progress":35}

### 设备 B 当前进度 65；不同设备可各有自己的 boot/seq
POST {{baseUrl}}/device/reports
X-Device-Id: {{deviceBId}}
X-Device-Token: {{deviceBToken}}
Content-Type: application/json

{"bootId":"{{bootB}}","seq":0,"eventId":"{{progressBEventId}}","executionId":"{{centralExecutionId}}","type":"PROGRESS","progress":65}

### 设备 C 当前进度 90；这三个请求可由模拟器并发发送
POST {{baseUrl}}/device/reports
X-Device-Id: {{deviceCId}}
X-Device-Token: {{deviceCToken}}
Content-Type: application/json

{"bootId":"{{bootC}}","seq":0,"eventId":"{{progressCEventId}}","executionId":"{{southExecutionId}}","type":"PROGRESS","progress":90}

### 展示三机真实平均进度与三项缺失，不能把上报完成等同资料验收
GET {{baseUrl}}/tasks/{{taskId}}/progress
Authorization: Bearer {{adminToken}}

### 6. 刷新 taskSnapshot，取北区当前子任务锁号后人工换机 A→D；原因必填
# 这是人工换机示例，不把它宣称为已验证真实离线超时。复制新 execution.id 为 northExecutionId。
POST {{baseUrl}}/subtasks/{{northSubtaskId}}/executions
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"droneId":"{{deviceDId}}","reason":"北区设备电量不足，改由备用机继续采集","expectedLockVersion":{{northSubtaskLockVersion}}}

### 执行历史保留原 A/CLOSED 与新 D/RUNNING，当前 D 进度从0开始
GET {{baseUrl}}/subtasks/{{northSubtaskId}}/executions?page=1&pageSize=20
Authorization: Bearer {{adminToken}}

### A 对原批次迟到的100%事件只属于历史，不抬高新 D 的当前进度
POST {{baseUrl}}/device/reports
X-Device-Id: {{deviceAId}}
X-Device-Token: {{deviceAToken}}
Content-Type: application/json

{"bootId":"{{bootA}}","seq":2,"eventId":"{{lateAEventId}}","executionId":"{{northOldExecutionId}}","type":"PROGRESS","progress":100}

### 新 D 只能报告其新执行；新事件使用自己的 boot/seq/event
POST {{baseUrl}}/device/reports
X-Device-Id: {{deviceDId}}
X-Device-Token: {{deviceDToken}}
Content-Type: application/json

{"bootId":"{{bootD}}","seq":0,"eventId":"{{progressDEventId}}","executionId":"{{northExecutionId}}","type":"PROGRESS","progress":100}

### 当前汇总仍指向新执行；后续北区旧新文件都明确属于此 northExecutionId
GET {{baseUrl}}/tasks/{{taskId}}/progress
Authorization: Bearer {{adminToken}}

### 7. 北区 V1：创建用户会话，原图79字节，复制 data.uploadId 为 oldUploadId
POST {{baseUrl}}/upload-sessions
Authorization: Bearer {{uploaderToken}}
Content-Type: application/json

{"clientRequestId":"{{oldUploadRequestId}}","requirementId":"{{northRequirementId}}","executionId":"{{northExecutionId}}","filename":"inspection-sample.png","contentType":"image/png","size":79}

### 原图单片字节上传；同会话/片号重试必须沿用相同字节
PUT {{baseUrl}}/upload-sessions/{{oldUploadId}}/parts/1
Authorization: Bearer {{uploaderToken}}
Content-Type: application/octet-stream

< ./files/inspection-sample.png

### HTTP202仅表示接纳异步定版，不保证本次响应已经有 versionId
POST {{baseUrl}}/upload-sessions/{{oldUploadId}}/complete
Authorization: Bearer {{uploaderToken}}

### 轮询直到 processingStatus=COMPLETED；复制 versionId 为 oldVersionId
GET {{baseUrl}}/upload-sessions/{{oldUploadId}}
Authorization: Bearer {{uploaderToken}}

### 独立复核 V1：必须是该任务的 OrgA OWNER_REVIEWER
POST {{baseUrl}}/evidence-versions/{{oldVersionId}}/review
Authorization: Bearer {{reviewerToken}}
Content-Type: application/json

{"decision":"APPROVED","expectedReviewStatus":"PENDING","reason":"北区第一版现场照片复核通过"}

### 查询真实存证，直到 CONFIRMED；UNKNOWN只显示待确认，不伪造状态或直接新建交易
GET {{baseUrl}}/evidence-versions/{{oldVersionId}}/anchor
Authorization: Bearer {{ownerToken}}

### 8. outsider 已知V1编号但目前无成员/共享授权：403
GET {{baseUrl}}/evidence-versions/{{oldVersionId}}
Authorization: Bearer {{outsiderToken}}

### 独立 V1 共享申请；真实未来 requestedValidUntil，例如当前时间+24h，不使用过期固定日期
POST {{baseUrl}}/access-grants
Authorization: Bearer {{outsiderToken}}
Content-Type: application/json

{"clientRequestId":"{{oldGrantRequestId}}","versionId":"{{oldVersionId}}","reason":"核对北区第一版巡检现场资料","requestedValidUntil":"{{requestedValidUntil}}"}

### 申请人仅能看到自己的申请元数据；复制返回 id、lockVersion 为 V1 授权变量
GET {{baseUrl}}/access-grants?mine=true&page=1&pageSize=20
Authorization: Bearer {{outsiderToken}}

### 任务共享审批队列，由显式加入任务的 OWNER_DATA_APPROVER 读取
GET {{baseUrl}}/access-grants?taskId={{taskId}}&page=1&pageSize=20
Authorization: Bearer {{approverToken}}

### 先确认V1已APPROVED+CONFIRMED；有效期为真实未来且不晚于申请期限（例如+12h）
POST {{baseUrl}}/access-grants/{{oldGrantId}}/decision
Authorization: Bearer {{approverToken}}
Content-Type: application/json

{"decision":"APPROVED","validUntil":"{{validUntil}}","expectedLockVersion":{{oldGrantLockVersion}}}

### 9. 同一北区当前执行上传合法不同内容 V2；公开样例实际为74字节；更换文件时必须更新 revisedSize
# inspection-revised.png 是公开样例，不覆盖原 PNG；新上传必须使用 newUploadRequestId。
POST {{baseUrl}}/upload-sessions
Authorization: Bearer {{uploaderToken}}
Content-Type: application/json

{"clientRequestId":"{{newUploadRequestId}}","requirementId":"{{northRequirementId}}","executionId":"{{northExecutionId}}","filename":"inspection-revised.png","contentType":"image/png","size":{{revisedSize}}}

### 复制新会话 id 为 newUploadId。此公开小PNG应为单片；以服务器返回的 partCount 为准
PUT {{baseUrl}}/upload-sessions/{{newUploadId}}/parts/1
Authorization: Bearer {{uploaderToken}}
Content-Type: application/octet-stream

< ./files/inspection-revised.png

### 新会话的异步定版
POST {{baseUrl}}/upload-sessions/{{newUploadId}}/complete
Authorization: Bearer {{uploaderToken}}

### 轮询 COMPLETED 并复制 newVersionId；同一个 evidenceId 下版本号增大
GET {{baseUrl}}/upload-sessions/{{newUploadId}}
Authorization: Bearer {{uploaderToken}}

### V2 独立为 PENDING，不继承 V1 复核；此处用任务复核员读
GET {{baseUrl}}/evidence-versions/{{newVersionId}}/review
Authorization: Bearer {{reviewerToken}}

### 此时 outsider 仍只被授予V1，V2为403；新版本不继承授权
GET {{baseUrl}}/evidence-versions/{{newVersionId}}
Authorization: Bearer {{outsiderToken}}

### 独立批准V2；若希望展示退回补交，请另用t018分支，不对已复核版本重写结论
POST {{baseUrl}}/evidence-versions/{{newVersionId}}/review
Authorization: Bearer {{reviewerToken}}
Content-Type: application/json

{"decision":"APPROVED","expectedReviewStatus":"PENDING","reason":"北区修订版独立复核通过"}

### 10. 中区资料创建、传片、完成、轮询；该资料是其自身V1，不是北区V3
POST {{baseUrl}}/upload-sessions
Authorization: Bearer {{uploaderToken}}
Content-Type: application/json

{"clientRequestId":"{{centralUploadRequestId}}","requirementId":"{{centralRequirementId}}","executionId":"{{centralExecutionId}}","filename":"inspection-sample.png","contentType":"image/png","size":79}

### 使用刚创建的 centralUploadId
PUT {{baseUrl}}/upload-sessions/{{centralUploadId}}/parts/1
Authorization: Bearer {{uploaderToken}}
Content-Type: application/octet-stream

< ./files/inspection-sample.png

### 中区定版接纳202
POST {{baseUrl}}/upload-sessions/{{centralUploadId}}/complete
Authorization: Bearer {{uploaderToken}}

### 等待COMPLETED，复制 centralVersionId
GET {{baseUrl}}/upload-sessions/{{centralUploadId}}
Authorization: Bearer {{uploaderToken}}

### 中区独立批准
POST {{baseUrl}}/evidence-versions/{{centralVersionId}}/review
Authorization: Bearer {{reviewerToken}}
Content-Type: application/json

{"decision":"APPROVED","expectedReviewStatus":"PENDING"}

### 南区资料单独创建，会话/请求/资料/执行编号均不复用北区或中区的值
POST {{baseUrl}}/upload-sessions
Authorization: Bearer {{uploaderToken}}
Content-Type: application/json

{"clientRequestId":"{{southUploadRequestId}}","requirementId":"{{southRequirementId}}","executionId":"{{southExecutionId}}","filename":"inspection-sample.png","contentType":"image/png","size":79}

### 南区传片
PUT {{baseUrl}}/upload-sessions/{{southUploadId}}/parts/1
Authorization: Bearer {{uploaderToken}}
Content-Type: application/octet-stream

< ./files/inspection-sample.png

### 南区定版接纳202
POST {{baseUrl}}/upload-sessions/{{southUploadId}}/complete
Authorization: Bearer {{uploaderToken}}

### 等待COMPLETED，复制 southVersionId
GET {{baseUrl}}/upload-sessions/{{southUploadId}}
Authorization: Bearer {{uploaderToken}}

### 南区独立批准
POST {{baseUrl}}/evidence-versions/{{southVersionId}}/review
Authorization: Bearer {{reviewerToken}}
Content-Type: application/json

{"decision":"APPROVED","expectedReviewStatus":"PENDING"}

### 当前资料应指向北区V2、中区V1、南区V1；等待三项anchor都CONFIRMED再正式完成
GET {{baseUrl}}/tasks/{{taskId}}/progress
Authorization: Bearer {{ownerToken}}

### 任务成员看见四固定版本；列表权限在SQL计数/分页前过滤
GET {{baseUrl}}/evidence-versions?taskId={{taskId}}&page=1&pageSize=20
Authorization: Bearer {{reviewerToken}}

### outsider 此时只看见精确V1，不因V2已通过而自动扩权
GET {{baseUrl}}/evidence-versions?taskId={{taskId}}&page=1&pageSize=20
Authorization: Bearer {{outsiderToken}}

### 11. STORED：原文件实际核验。必须无请求体、无Content-Type，查询串仅source=STORED
POST {{baseUrl}}/evidence-versions/{{oldVersionId}}/verifications?source=STORED
Authorization: Bearer {{outsiderToken}}

### COPY原图：MATCH；文件项只能有一个且名为file
POST {{baseUrl}}/evidence-versions/{{oldVersionId}}/verifications?source=COPY
Authorization: Bearer {{outsiderToken}}
Content-Type: multipart/form-data; boundary=t029-original-copy

--t029-original-copy
Content-Disposition: form-data; name="file"; filename="inspection-sample.png"
Content-Type: image/png

< ./files/inspection-sample.png
--t029-original-copy--

### COPY合法修订图对比V1：MISMATCH；只核验副本，不改正式对象或新建文件版本
POST {{baseUrl}}/evidence-versions/{{oldVersionId}}/verifications?source=COPY
Authorization: Bearer {{outsiderToken}}
Content-Type: multipart/form-data; boundary=t029-revised-copy

--t029-revised-copy
Content-Disposition: form-data; name="file"; filename="inspection-revised.png"
Content-Type: image/png

< ./files/inspection-revised.png
--t029-revised-copy--

### 核验历史保留独立source/actualHash/ledgerHash/结果，仍重新检查当前授权
GET {{baseUrl}}/evidence-versions/{{oldVersionId}}/verifications?page=1&pageSize=20
Authorization: Bearer {{outsiderToken}}

### 短期签发；响应data.url只在私有客户端即时导航，不复制到文档、公开截图或日志
# 签发审计不等于已经下载成功；地址最多300秒且不超过该授权剩余期限。
POST {{baseUrl}}/evidence-versions/{{oldVersionId}}/download-url
Authorization: Bearer {{outsiderToken}}

### 一个版本的授权不开放父任务：403
GET {{baseUrl}}/tasks/{{taskId}}
Authorization: Bearer {{outsiderToken}}

### 12. 刷新taskSnapshot得到当前锁号后，由运营方提交；不直接用飞行100%完成
POST {{baseUrl}}/tasks/{{taskId}}/submit-acceptance
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"expectedLockVersion":{{taskLockVersion}}}

### 再刷新taskSnapshot：待验收且三项当前最新版均APPROVED+CONFIRMED，委托方完成
POST {{baseUrl}}/tasks/{{taskId}}/complete
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{"expectedLockVersion":{{taskLockVersion}}}

### 13. 完成后仍可管理历史授权。先GET审批队列更新oldGrantLockVersion再撤销V1
POST {{baseUrl}}/access-grants/{{oldGrantId}}/revoke
Authorization: Bearer {{approverToken}}
Content-Type: application/json

{"reason":"第一版对比已结束，撤销旧版访问","expectedLockVersion":{{oldGrantLockVersion}}}

### 撤销后不能再读取V1或签发新下载地址：403；旧签名地址仍可能在原expiresAt前有效
GET {{baseUrl}}/evidence-versions/{{oldVersionId}}
Authorization: Bearer {{outsiderToken}}

### V2必须新建独立申请，不能修改V1授权versionId；更新未来期限（请求约24h、批准约12h）
POST {{baseUrl}}/access-grants
Authorization: Bearer {{outsiderToken}}
Content-Type: application/json

{"clientRequestId":"{{newGrantRequestId}}","versionId":"{{newVersionId}}","reason":"申请保留修订后的北区现场资料用于核对","requestedValidUntil":"{{requestedValidUntil}}"}

### 从本人/审批列表取新申请id和lockVersion，填newGrantId/newGrantLockVersion后独立批准
POST {{baseUrl}}/access-grants/{{newGrantId}}/decision
Authorization: Bearer {{approverToken}}
Content-Type: application/json

{"decision":"APPROVED","validUntil":"{{validUntil}}","expectedLockVersion":{{newGrantLockVersion}}}

### 最终 outsider 只看到 V2；V1已撤销，中区/南区未授权，父任务仍403
GET {{baseUrl}}/evidence-versions?taskId={{taskId}}&page=1&pageSize=20
Authorization: Bearer {{outsiderToken}}

### 14. 委托方管理成员查看真实任务审计
GET {{baseUrl}}/tasks/{{taskId}}/audit-logs?page=1&pageSize=100
Authorization: Bearer {{ownerToken}}

### 旧新固定版关系：同资料项、同当前执行内的V2才是latestInExecution；保留V1原复核/存证
GET {{baseUrl}}/tasks/{{taskId}}/evidence-relations?requirementId={{northRequirementId}}&page=1&pageSize=20
Authorization: Bearer {{ownerToken}}

### 完成的任务及固定completedAt继续可读，不重开任务以修改历史成果
GET {{baseUrl}}/tasks/{{taskId}}
Authorization: Bearer {{ownerToken}}

# 备选分支：拒绝/到期见t020；退回补交见t018；设备启停见t015；
# 设备身份上传见t015/t016（设备会话不能由用户接管）；多分片/续传见t017/t028；
# 人工存证重检见t024；角色修改/退出见t008；专项故障见t022～t027。
# 这些备选请求不能随意插入上面的完成主线；T030会完整执行12项最终验收。
