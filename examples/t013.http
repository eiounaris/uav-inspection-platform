# Prerequisites: complete t009.http through t012.http using the bundled inspection-sample.png.
# Start: python3 deploy/scripts/run-backend.py --demo --ledger
# Copy the completed uploadId below. Keep real passwords/tokens in an ignored REST Client environment.
@baseUrl = http://127.0.0.1:8080
@uploadId = REPLACE_WITH_COMPLETED_UPLOAD_UUID
@operatorUserPassword = REPLACE_WITH_OPERATOR_USER_PASSWORD
@ownerAdminPassword = REPLACE_WITH_OWNER_ADMIN_PASSWORD
@operatorOutsiderPassword = REPLACE_WITH_OPERATOR_OUTSIDER_PASSWORD

### Log in as a task member
# @name uploaderLogin
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{"username":"operator-user","password":"{{operatorUserPassword}}"}

### Obtain the immutable versionId
# @name upload
GET {{baseUrl}}/api/v1/upload-sessions/{{uploadId}}
Authorization: Bearer {{uploaderLogin.response.body.$.data.accessToken}}

### STORED reads real private-object bytes and queries this user's institution Gateway
# No request body or Content-Type. A healthy anchored original returns result=MATCH.
POST {{baseUrl}}/api/v1/evidence-versions/{{upload.response.body.$.data.versionId}}/verifications?source=STORED
Authorization: Bearer {{uploaderLogin.response.body.$.data.accessToken}}
X-Trace-Id: t013-stored

### COPY checks this request-local file. Identical bytes return MATCH without creating a version.
POST {{baseUrl}}/api/v1/evidence-versions/{{upload.response.body.$.data.versionId}}/verifications?source=COPY
Authorization: Bearer {{uploaderLogin.response.body.$.data.accessToken}}
Content-Type: multipart/form-data; boundary=inspection-copy-boundary
X-Trace-Id: t013-identical-copy

--inspection-copy-boundary
Content-Disposition: form-data; name="file"; filename="inspection-sample.png"
Content-Type: image/png

< ./files/inspection-sample.png
--inspection-copy-boundary--

### Prepare a local tampered copy from the repository root before running the next request:
# python3 -c 'from pathlib import Path; b=bytearray(Path("examples/files/inspection-sample.png").read_bytes()); b[-9]^=1; Path(".local/inspection-sample-tampered.png").write_bytes(b)'
# The PNG signature is kept. COPY compares actual bytes; it never replaces the original.
### MISMATCH is a successful verification result (HTTP 200), distinct from an unavailable dependency.
POST {{baseUrl}}/api/v1/evidence-versions/{{upload.response.body.$.data.versionId}}/verifications?source=COPY
Authorization: Bearer {{uploaderLogin.response.body.$.data.accessToken}}
Content-Type: multipart/form-data; boundary=inspection-tampered-boundary
X-Trace-Id: t013-tampered-copy

--inspection-tampered-boundary
Content-Disposition: form-data; name="file"; filename="inspection-sample.png"
Content-Type: image/png

< ../.local/inspection-sample-tampered.png
--inspection-tampered-boundary--

### Results include complete actual/ledger hashes, source, actor, reason and verification time
GET {{baseUrl}}/api/v1/evidence-versions/{{upload.response.body.$.data.versionId}}/verifications?page=1&pageSize=20
Authorization: Bearer {{uploaderLogin.response.body.$.data.accessToken}}

### OrgA uses its own actual Gateway identity when reading the same version's ledger record
# @name ownerLogin
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{"username":"owner-admin","password":"{{ownerAdminPassword}}"}

### Only succeeds if this owner is still a task member with an applicable business role
POST {{baseUrl}}/api/v1/evidence-versions/{{upload.response.body.$.data.versionId}}/verifications?source=STORED
Authorization: Bearer {{ownerLogin.response.body.$.data.accessToken}}

### A business role alone does not grant this version or its history
# @name outsiderLogin
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{"username":"operator-outsider","password":"{{operatorOutsiderPassword}}"}

### 403
GET {{baseUrl}}/api/v1/evidence-versions/{{upload.response.body.$.data.versionId}}/verifications
Authorization: Bearer {{outsiderLogin.response.body.$.data.accessToken}}

### 401
POST {{baseUrl}}/api/v1/evidence-versions/{{upload.response.body.$.data.versionId}}/verifications?source=STORED
