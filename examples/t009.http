# Start the database backend: python3 deploy/scripts/run-backend.py --demo
# Supply credentials from .local/demo-credentials.json in an ignored REST Client environment.
# Run requests in order. They create a real task and retain its data for later upload examples.
@baseUrl = http://127.0.0.1:8080
@ownerPassword = REPLACE_WITH_OWNER_ADMIN_PASSWORD
@operatorPassword = REPLACE_WITH_OPERATOR_ADMIN_PASSWORD
@operatorOrgId = 00000000-0000-4000-8000-000000000002
@operatorAdminId = 10000000-0000-4000-8000-000000000004
@ownerReviewerId = 10000000-0000-4000-8000-000000000002
@droneId = 20000000-0000-4000-8000-000000000001

### Owner login
# @name ownerLogin
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{"username":"owner-admin","password":"{{ownerPassword}}"}

### Operator login
# @name operatorLogin
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{"username":"operator-admin","password":"{{operatorPassword}}"}

### Create a draft; the backend adds the creator as a task member
# @name draft
POST {{baseUrl}}/api/v1/tasks
Authorization: Bearer {{ownerLogin.response.body.$.data.accessToken}}
Content-Type: application/json
X-Trace-Id: t009-create

{
  "name": "园区 A 区设备巡检",
  "scope": "检查 A 区设备外观，提交一张现场照片",
  "requirements": [{"name":"设备外观照片","required":true}]
}

### Maintain the requirement while preserving its stable evidence identifier
# @name requirements
PUT {{baseUrl}}/api/v1/tasks/{{draft.response.body.$.data.id}}/requirements
Authorization: Bearer {{ownerLogin.response.body.$.data.accessToken}}
Content-Type: application/json
X-Trace-Id: t009-requirements

{
  "requirements": [{"id":"{{draft.response.body.$.data.requirements[0].id}}","name":"设备外观清晰照片","required":true}],
  "expectedLockVersion": {{draft.response.body.$.data.lockVersion}}
}

### Assign the task; the operator administrator becomes a member
# @name assigned
POST {{baseUrl}}/api/v1/tasks/{{draft.response.body.$.data.id}}/assign
Authorization: Bearer {{ownerLogin.response.body.$.data.accessToken}}
Content-Type: application/json
X-Trace-Id: t009-assign

{
  "operatorOrgId": "{{operatorOrgId}}",
  "operatorAdminId": "{{operatorAdminId}}",
  "expectedLockVersion": {{requirements.response.body.$.data.lockVersion}}
}

### Replace the owner's managed members; retain creator and operator members
# @name members
PUT {{baseUrl}}/api/v1/tasks/{{draft.response.body.$.data.id}}/members
Authorization: Bearer {{ownerLogin.response.body.$.data.accessToken}}
Content-Type: application/json
X-Trace-Id: t009-members

{
  "userIds": ["{{ownerReviewerId}}"],
  "expectedLockVersion": {{assigned.response.body.$.data.lockVersion}}
}

### Lists filter task membership before pagination and total count
GET {{baseUrl}}/api/v1/tasks?page=1&pageSize=20
Authorization: Bearer {{operatorLogin.response.body.$.data.accessToken}}

### Operator creates a subtask and binds the owner's existing requirement
# @name subdivided
POST {{baseUrl}}/api/v1/tasks/{{draft.response.body.$.data.id}}/subtasks
Authorization: Bearer {{operatorLogin.response.body.$.data.accessToken}}
Content-Type: application/json
X-Trace-Id: t009-subtask

{
  "name": "A 区设备外观采集",
  "requirementIds": ["{{draft.response.body.$.data.requirements[0].id}}"],
  "expectedLockVersion": {{members.response.body.$.data.lockVersion}}
}

### Initial allocation creates a READY batch; expectedLockVersion belongs to the subtask
# @name execution
POST {{baseUrl}}/api/v1/subtasks/{{subdivided.response.body.$.data.subtasks[0].id}}/executions
Authorization: Bearer {{operatorLogin.response.body.$.data.accessToken}}
Content-Type: application/json
X-Trace-Id: t009-execution

{
  "droneId": "{{droneId}}",
  "expectedLockVersion": {{subdivided.response.body.$.data.subtasks[0].lockVersion}}
}

### Refresh the task's aggregate version after allocating the device
# @name prepared
GET {{baseUrl}}/api/v1/tasks/{{draft.response.body.$.data.id}}
Authorization: Bearer {{operatorLogin.response.body.$.data.accessToken}}

### Start reuses the READY batch identifier and changes it to RUNNING
# @name started
POST {{baseUrl}}/api/v1/tasks/{{draft.response.body.$.data.id}}/start
Authorization: Bearer {{operatorLogin.response.body.$.data.accessToken}}
Content-Type: application/json
X-Trace-Id: t009-start

{"expectedLockVersion":{{prepared.response.body.$.data.lockVersion}}}

### A repeated start returns 409 and does not create another batch
POST {{baseUrl}}/api/v1/tasks/{{draft.response.body.$.data.id}}/start
Authorization: Bearer {{operatorLogin.response.body.$.data.accessToken}}
Content-Type: application/json
X-Trace-Id: t009-start-repeat

{"expectedLockVersion":{{started.response.body.$.data.lockVersion}}}
