# Local configuration contract; Spring Boot does not automatically load .env.
# T002 reads SPRING_PROFILES_ACTIVE, SERVER_ADDRESS and SERVER_PORT from process env.
# T003 Compose reads this file only when passed using --env-file.
# T006 Gateway probe uses .local/fabric/gateway-paths.json for the two User1 identities.
# Backend launchers read DB_*, S3_*, UPLOAD_*, VERIFICATION_*, RABBITMQ_*, MESSAGING_*, FABRIC_*, JWT_SECRET and DEMO_CREDENTIALS_PATH.
# Authentication, tasks, private storage and asynchronous finalization use these settings.
# This file does not switch JAVA_HOME or start any service; keep secrets local.

PROJECT_JAVA_HOME=
SPRING_PROFILES_ACTIVE=local
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
TZ=UTC

# Fixed tag + digest references; runtime verification is recorded in docs/verification.md.
MYSQL_IMAGE=mysql:8.4.11@sha256:24989179f58856db763f418010c1169fecc944e3ec1ea7e921572d83eb070f70
REDIS_IMAGE=redis:7.4.11-bookworm@sha256:4fa24486b8bcca8eec45ee0eb166edc674795e53a2b53d1a9ef263eecebaac85
RABBITMQ_IMAGE=rabbitmq:4.2.9-management@sha256:7ce498399b07a9594a3d23e5a7920edf233edb888e82503c35357c23cefc2e61
S3_IMAGE=dxflrs/garage:v2.4.1@sha256:9c96caa2612d3411acc5b0e6701fb238dbfba33e533a6d7d3d811a4b12d0d020

# Localhost endpoints assume the backend runs on the host during development.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=uav_inspection
DB_USERNAME=uav_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Connector/J requires encryption; local MySQL has a generated server certificate.
DB_SSL_MODE=REQUIRED
# Points to ignored credentials; used only with explicit local,database,demo profiles.
DEMO_CREDENTIALS_PATH=.local/demo-credentials.json

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=uav_app
RABBITMQ_PASSWORD=
RABBITMQ_VIRTUAL_HOST=/
# T011 durable event topology. Override all names together for an isolated verification run.
MESSAGING_EXCHANGE=inspection.events
MESSAGING_FINALIZE_QUEUE=inspection.file.finalize
MESSAGING_ANCHOR_QUEUE=inspection.evidence.anchor
MESSAGING_DEAD_LETTER_EXCHANGE=inspection.dead.events
MESSAGING_DEAD_LETTER_QUEUE=inspection.dead
MESSAGING_PUBLISH_DELAY_MS=1000
MESSAGING_RECOVERY_DELAY_MS=10000

S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_INTERNAL_ENDPOINT=http://s3:3900
S3_PORT=9000
# Must match deploy/garage.toml.
S3_REGION=garage
S3_BUCKET=uav-evidence
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=
S3_SECRET_KEY=

# T010 upload limits in bytes/seconds; existing .env files use these application defaults.
UPLOAD_MAX_FILE_SIZE=209715200
UPLOAD_PART_SIZE=8388608
UPLOAD_SESSION_TTL_SECONDS=86400
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,mp4
UPLOAD_TEMP_DIRECTORY=.local/uploads/tmp
UPLOAD_MIN_FREE_SPACE=33554432
# T013 copy size in bytes, processing concurrency and deadline after HTTP reception.
VERIFICATION_MAX_FILE_SIZE=209715200
VERIFICATION_CONCURRENCY=2
VERIFICATION_TIMEOUT_SECONDS=60
VERIFICATION_TEMP_DIRECTORY=.local/uploads/verification
VERIFICATION_MIN_FREE_SPACE=33554432
VERIFICATION_ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,mp4
# Garage node authentication; no host RPC/admin port is published.
GARAGE_RPC_SECRET=

# Exactly 64 lowercase hex characters (32 random bytes); init-env.py generates it once.
# Keep the original value across restarts; replacing it invalidates all existing access tokens.
JWT_SECRET=

# Network/tool lock: deploy/fabric/versions.json; SDK library versions are pinned in backend/pom.xml.
# run-backend.py --ledger opts into real business anchoring. Local runs fill blank identity
# paths from the existing ordinary User1 manifest. Prod requires explicit identity paths.
# Without --ledger no identity files are read and the anchor queue remains unconsumed.
FABRIC_IDENTITY_MANIFEST=.local/fabric/gateway-paths.json
FABRIC_RECOVERY_DELAY_MS=10000
FABRIC_VERSION=2.5.16
FABRIC_SAMPLES_COMMIT=5789681b4f4d24e58fa40f19a69f5496892374b6
FABRIC_GATEWAY_VERSION=1.13.0
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=evidence
FABRIC_CONTRACT=EvidenceContract
FABRIC_ORGA_MSP_ID=Org1MSP
FABRIC_ORGA_GATEWAY_ENDPOINT=localhost:7051
FABRIC_ORGA_TLS_SERVER_NAME=peer0.org1.example.com
FABRIC_ORGA_CERT_PATH=
FABRIC_ORGA_KEY_PATH=
FABRIC_ORGA_TLS_CERT_PATH=
FABRIC_ORGB_MSP_ID=Org2MSP
FABRIC_ORGB_GATEWAY_ENDPOINT=localhost:9051
FABRIC_ORGB_TLS_SERVER_NAME=peer0.org2.example.com
FABRIC_ORGB_CERT_PATH=
FABRIC_ORGB_KEY_PATH=
FABRIC_ORGB_TLS_CERT_PATH=
